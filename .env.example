# Supabase project (Settings → API). Both values are public by design:
# Row Level Security in supabase/migrations/ decides what they can do.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Safari proxy Worker (npm run proxy:deploy prints its *.workers.dev URL, no trailing slash).
# Optional: without it Safari frames sites directly and many (Google, GitHub…) stay blank.
VITE_SAFARI_PROXY_URL=
